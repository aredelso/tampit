// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Roaster {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  contactEmail String?
  location     String?
  logoUrl      String?
  userId       String?
  user         User?         @relation("RoasterOwner", fields: [userId], references: [id], onDelete: SetNull)
  manager      User?         @relation("RoasterManager")
  entries      CoffeeEntry[]
  coffees      Coffee[]
  followers    RoasterFollow[] @relation("RoasterFollows")

  @@index([userId])
}

model Coffee {
  id          Int           @id @default(autoincrement())
  name        String
  origin      String?
  variety     String?
  farm        String?
  process     String?
  description String?
  photoUrl    String?
  roasterId   Int
  roaster     Roaster       @relation(fields: [roasterId], references: [id])
  entries     CoffeeEntry[]
  wishlist    Wishlist[]
  inventory   CoffeeInventory[]

  @@unique([name, roasterId])
}

model CoffeeEntry {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  roasterId  Int
  roaster    Roaster @relation(fields: [roasterId], references: [id])
  coffeeId    Int
  coffee   Coffee  @relation(fields: [coffeeId], references: [id])
  flavorNotes String[]
  origin     String?
  brewMethod String
  dose       Int?
  waterMl    Int?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  notes      String?
  rating     Float?
  photoUrl   String?
  recipeId   Int?
  recipe     Recipe?  @relation(fields: [recipeId], references: [id])
  likes      Like[]
  comments   Comment[]
}

model FlavorTag {
  id   Int    @id @default(autoincrement())
  name String @unique
}

enum UserType {
  STANDARD
  ROASTER
}

model User {
  id              String        @id @default(cuid())
  name            String?
  email           String?       @unique
  passwordHash    String?
  photo           String?
  userType        UserType      @default(STANDARD)
  verified        Boolean       @default(false)
  googleId        String?       @unique
  roasterId       Int?          @unique
  roaster         Roaster?      @relation("RoasterManager", fields: [roasterId], references: [id], onDelete: SetNull)
  entries         CoffeeEntry[]
  likes           Like[]
  comments        Comment[]
  commentLikes    CommentLike[]
  wishlist        Wishlist[]
  recipes         Recipe[]
  recipeLikes     RecipeLike[]
  roasters        Roaster[]      @relation("RoasterOwner")
  following       UserFollow[]    @relation("UserFollowing")
  followers       UserFollow[]    @relation("UserFollowers")
  roasterFollows  RoasterFollow[] @relation("RoasterFollowers")
  inventory       CoffeeInventory[]
}

model Like {
  id        Int         @id @default(autoincrement())
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id])
  userId    String
  entry     CoffeeEntry @relation(fields: [entryId], references: [id])
  entryId   Int

  @@unique([userId, entryId])
}

model Comment {
  id        Int           @id @default(autoincrement())
  createdAt DateTime      @default(now())
  content   String
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  entry     CoffeeEntry   @relation(fields: [entryId], references: [id])
  entryId   Int
  likes     CommentLike[]
}

model CommentLike {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  comment   Comment  @relation(fields: [commentId], references: [id])
  commentId Int

  @@unique([userId, commentId])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  coffeeId  Int
  coffee    Coffee   @relation(fields: [coffeeId], references: [id], onDelete: Cascade)

  @@unique([userId, coffeeId])
}

model Recipe {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String
  description String?
  brewMethod  String?
  grindSize   String?
  phases      Json     @default("[]")
  dose  Int?
  waterMl  Int?
  brewTime    Int?
  notes       String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  likes       RecipeLike[]
  entries     CoffeeEntry[]

  @@index([userId])
}

model RecipeLike {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  recipe    Recipe   @relation(fields: [recipeId], references: [id])
  recipeId  Int

  @@unique([userId, recipeId])
}

model UserFollow {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model RoasterFollow {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  followerId String
  follower   User     @relation("RoasterFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  roasterId  Int
  roaster    Roaster  @relation("RoasterFollows", fields: [roasterId], references: [id], onDelete: Cascade)

  @@unique([followerId, roasterId])
  @@index([followerId])
  @@index([roasterId])
}

model CoffeeInventory {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coffeeId  Int
  coffee    Coffee   @relation(fields: [coffeeId], references: [id], onDelete: Cascade)
  roastDate DateTime?
  quantity  Int      @default(1)
  notes     String?

  @@unique([userId, coffeeId])
  @@index([userId])
  @@index([coffeeId])
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  email     String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([email])
}
